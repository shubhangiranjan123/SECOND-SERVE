+}
+
+.need-quiet {
+  border-style: dashed;
+  border-color: var(--ink-faint);
+  background: transparent;
+}
+
+.need-top {
+  display: flex;
+  gap: 14px;
+  align-items: center;
+}
+
+.need h3 {
+  font-size: 18px;
+  font-weight: 800;
+  line-height: 1.2;
+}
+
+.need.is-first h3 {
+  font-family: var(--font-display);
+  font-size: 23px;
+  letter-spacing: -0.02em;
+}
+
+.need-top p,
+.need-meta {
+  margin-top: 3px;
+  font-size: 14px;
+  color: var(--ink-soft);
+}
+
+.need-line {
+  font-size: 15.5px;
+}
+
+.need-best {
+  padding: 10px 12px;
+  border-radius: 12px;
+  background: var(--mint-soft);
+  font-size: 14.5px;
+  color: var(--green-deep);
+}
+
+.need-warn {
+  padding: 10px 12px;
+  border-radius: 12px;
+  background: var(--pink-soft);
+  font-size: 14.5px;
+  font-weight: 600;
+  color: var(--pink-deep);
+}
+
+.need-actions {
+  display: flex;
+  gap: 8px;
+}
+
+.need-actions .button-primary {
+  flex: 1;
+}
+
+.road {
