@@ -0,0 +1,116 @@
+import type { RescueRecord } from './types'
+import './Garden.css'
+
+// Estimates, shown on the page next to the numbers:
+// WRAP meal-equivalent guidance uses 420 g per meal (the lowest common factor),
+// FAO "Food wastage footprint" (2013): 3.3 Gt CO2e for 1.3 Gt of food ≈ 2.5 kg per kg.
+const KG_PER_SERVING = 0.42
+const CO2E_PER_KG = 2.5
+
+const PETALS = ['#e2447f', '#ff8fbc', '#ffc2da', '#ff7daf']
+
+// A stable pseudo-random number from a string, so each rescue's flower
+// keeps the same spot and height every time the page loads.
+function seeded(text: string, salt: number) {
+  let h = 2166136261 ^ salt
+  for (let i = 0; i < text.length; i++) {
+    h ^= text.charCodeAt(i)
+    h = Math.imul(h, 16777619)
+  }
+  return ((h >>> 0) % 10_000) / 10_000
+}
+
+type Props = {
+  history: RescueRecord[]
+}
+
+export default function Garden({ history }: Props) {
+  const servings = history.reduce((sum, r) => sum + r.servings, 0)
+  const samples = history.filter((r) => r.sample).length
+  const kgFood = Math.round(servings * KG_PER_SERVING)
+  const kgCo2 = Math.round(servings * KG_PER_SERVING * CO2E_PER_KG)
+
+  // Oldest first, so new flowers are drawn on top.
+  const flowers = [...history].reverse().map((r) => ({
+    key: r.rescueId,
+    left: 3 + seeded(r.rescueId, 1) * 88,
+    height: 130 + seeded(r.rescueId, 2) * 110,
+    petal: PETALS[Math.floor(seeded(r.rescueId, 3) * PETALS.length)],
+    title: `${r.food} to ${r.ngoName}, ${r.servings} servings`,
+  }))
+
+  return (
+    <section className="garden" id="garden" aria-labelledby="garden-title">
+      <div className="garden-top">
+        <div>
+          <h2 id="garden-title">Every rescue grows something</h2>
+          <p className="garden-sub">
+            One flower for each delivery a runner completes. They stay, so the garden is your
+            running climate record.
+          </p>
+        </div>
+        <div className="garden-stats">
+          <div>
+            <span className="garden-num num" style={{ color: 'var(--mint)' }}>
+              {servings.toLocaleString()}
+            </span>
+            <span>servings eaten, not binned</span>
+          </div>
+          <div>
+            <span className="garden-num num">{kgFood.toLocaleString()}</span>
+            <span>kg of food rescued</span>
+          </div>
+          <div>
+            <span className="garden-num num" style={{ color: 'var(--pink-bright)' }}>
+              {kgCo2.toLocaleString()}
+            </span>
+            <span>kg CO₂e kept out of the air</span>
+          </div>
+        </div>
+      </div>
+
+      <div className="garden-bed">
+        {flowers.length === 0 && (
+          <p className="garden-empty">
+            Nothing planted yet. Mark a delivery done in Dispatch and the first flower appears
+            here.
+          </p>
+        )}
+        {flowers.map((f) => (
+          <div
+            className="flower"
+            key={f.key}
+            style={{ left: `${f.left}%`, height: f.height }}
+            title={f.title}
+          >
+            <svg
+              className="flower-sway"
+              viewBox="0 0 90 220"
+              preserveAspectRatio="xMidYMax meet"
+              aria-hidden="true"
+            >
+              <path d="M45 220 C45 170 40 120 46 60" fill="none" stroke="#20b26b" strokeWidth="7" strokeLinecap="round" />
+              <path d="M44 160 C24 150 14 132 16 116 C34 120 44 136 44 160 Z" fill="#20b26b" />
+              <path d="M46 130 C66 122 76 104 74 88 C56 92 46 108 46 130 Z" fill="#5fe0a0" />
+              <g className="flower-head">
+                <circle cx="46" cy="40" r="17" fill={f.petal} />
+                <circle cx="28" cy="52" r="15" fill={f.petal} />
+                <circle cx="64" cy="52" r="15" fill={f.petal} />
+                <circle cx="34" cy="70" r="14" fill={f.petal} />
+                <circle cx="58" cy="70" r="14" fill={f.petal} />
+                <circle cx="46" cy="56" r="11" fill="#ffe27a" />
+              </g>
+            </svg>
+          </div>
+        ))}
+        <div className="garden-ground" />
+      </div>
+
+      <p className="garden-note">
+        {samples > 0 && `Includes ${samples} sample rescues from earlier today. `}
+        Estimates: 420 g per serving (WRAP meal equivalent), 2.5 kg CO₂e per kg of food wasted
+        (FAO, Food wastage footprint).
+      </p>
+    </section>
+  )
+}
diff --git a/src/ListingModal.tsx b/src/ListingModal.tsx
new file mode 100644
index 0000000..2cfcb54
--- /dev/null
+++ b/src/ListingModal.tsx
@@ -0,0 +1,148 @@
+import { useState, type FormEvent } from 'react'
+import { X } from 'lucide-react'
+import { AREAS, defaultStorage, findArea } from './demoData'
+import { UNITS, type FullListing } from './useRescueData'
+import type { Donation, StorageType } from './types'
+
+const MIN = 60_000
+
+// datetime-local inputs use local time in the form "2026-11-11T18:30"
+function toLocalInput(ts: number) {
+  const d = new Date(ts)
+  const pad = (n: number) => String(n).padStart(2, '0')
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`
+}
+
+type Props = {
+  editing: Donation | null
+  onSave: (input: FullListing) => void
+  onClose: () => void
+}
+
+// The full listing form, for the coordinator adding or fixing a listing.
+// Donors use the 3-tap form on their own screen instead.
+export default function ListingModal({ editing, onSave, onClose }: Props) {
+  const [now] = useState(() => Date.now())
+  const [name, setName] = useState(editing?.name ?? '')
+  const [donor, setDonor] = useState(editing?.donor ?? '')
+  const [category, setCategory] = useState(editing?.category ?? 'Meals')
+  const [quantity, setQuantity] = useState(String(editing?.quantity ?? 10))
+  const [location, setLocation] = useState(editing ? findArea(editing.location).name : AREAS[2].name)
+  const [storage, setStorage] = useState<StorageType>(editing?.storage ?? 'Chilled')
+  const [readyIn, setReadyIn] = useState(editing ? String(Math.max(0, Math.round((editing.readyAt - now) / MIN))) : '0')
+  const [safeUntil, setSafeUntil] = useState(toLocalInput(editing?.safeUntil ?? now + 3 * 60 * MIN))
+  const [pickup, setPickup] = useState(editing?.pickup ?? '')
+  const [error, setError] = useState('')
+
+  function submit(event: FormEvent) {
+    event.preventDefault()
+    const at = Date.now()
+    const deadline = new Date(safeUntil).getTime()
+    const readyAt = at + Math.max(0, Number(readyIn) || 0) * MIN
+    if (!name.trim() || !donor.trim()) return setError('Add the food name and the donor.')
+    if (!Number.isFinite(deadline) || deadline <= at) return setError('The safe-use deadline must be in the future.')
+    if (readyAt >= deadline) return setError('Food must be ready for pickup before its safe-use deadline.')
+    onSave({
+      name: name.trim(),
+      donor: donor.trim(),
+      category,
+      quantity: Math.max(1, Number(quantity) || 1),
+      location,
+      pickup: pickup.trim(),
+      storage,
+      readyAt,
+      safeUntil: deadline,
+    })
+  }
+
+  return (
+    <div className="modal-backdrop" onMouseDown={(e) => e.target === e.currentTarget && onClose()}>
+      <section className="modal" role="dialog" aria-modal="true" aria-labelledby="listing-title">
+        <div className="modal-head">
+          <div>
+            <h2 id="listing-title">{editing ? 'Edit listing' : 'Add a listing'}</h2>
+            <p>For listings phoned in or fixed by the coordinator.</p>
+          </div>
+          <button className="modal-close" onClick={onClose} aria-label="Close" type="button">
+            <X size={20} />
+          </button>
+        </div>
+        <form onSubmit={submit} className="form" noValidate>
+          <label className="field">
+            Food
+            <input required maxLength={80} placeholder="Vegetable biryani" value={name} onChange={(e) => setName(e.target.value)} />
+          </label>
+          <label className="field">
+            Donor or business
+            <input required maxLength={80} placeholder="The Green Kitchen" value={donor} onChange={(e) => setDonor(e.target.value)} />
+          </label>
+          <div className="form-row">
+            <label className="field">
+              Category
+              <select
+                value={category}
+                onChange={(e) => {
+                  setCategory(e.target.value)
+                  setStorage(defaultStorage(e.target.value))
+                }}
+              >
+                <option>Meals</option>
+                <option>Bakery</option>
+                <option>Produce</option>
+              </select>
+            </label>
+            <label className="field">
+              Quantity ({UNITS[category]})
+              <input type="number" min="1" max="10000" value={quantity} onChange={(e) => setQuantity(e.target.value)} />
+            </label>
+          </div>
+          <div className="form-row">
+            <label className="field">
+              Pickup area
+              <select value={location} onChange={(e) => setLocation(e.target.value)}>
+                {AREAS.map((a) => (
+                  <option key={a.name}>{a.name}</option>
+                ))}
+              </select>
+            </label>
+            <label className="field">
+              Storage
+              <select value={storage} onChange={(e) => setStorage(e.target.value as StorageType)}>
+                <option value="Ambient">Room temperature</option>
+                <option value="Chilled">Chilled</option>
+                <option value="Frozen">Frozen</option>
+              </select>
+            </label>
+          </div>
+          <div className="form-row">
+            <label className="field">
+              Ready in (minutes)
+              <input type="number" min="0" max="1440" value={readyIn} onChange={(e) => setReadyIn(e.target.value)} />
+            </label>
+            <label className="field">
+              Safe to eat until
+              <input type="datetime-local" value={safeUntil} onChange={(e) => setSafeUntil(e.target.value)} />
+            </label>
+          </div>
+          <label className="field">
+            Pickup note
+            <input maxLength={100} placeholder="Before 7 PM, back door" value={pickup} onChange={(e) => setPickup(e.target.value)} />
+          </label>
+          {error && (
+            <p className="form-error" role="alert">
+              {error}
+            </p>
+          )}
+          <div className="modal-actions">
+            <button type="button" className="button-ghost" onClick={onClose}>
+              Cancel
+            </button>
+            <button type="submit" className="button-primary">
+              {editing ? 'Save changes' : 'Publish listing'}
+            </button>
+          </div>
+        </form>
+      </section>
+    </div>
+  )
+}
