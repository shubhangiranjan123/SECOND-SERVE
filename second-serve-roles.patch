+  }
+}
+
+@media (max-width: 640px) {
+  .coord-page {
+    padding: 28px 18px 48px;
+  }
+
+  .waste-ticker-num {
+    font-size: 22px;
+  }
+}
diff --git a/src/CoordinatorView.tsx b/src/CoordinatorView.tsx
