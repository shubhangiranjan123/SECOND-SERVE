+/* ==================================================================
+   Story page: the pitch, top to bottom.
+   ================================================================== */
+
+.story > .turn,
+.how,
+.story-garden,
+.story-end,
+.story > .footer {
+  max-width: 1240px;
+  margin-left: auto;
+  margin-right: auto;
+  padding-left: 32px;
+  padding-right: 32px;
+}
+
+.story > .footer {
+  margin-bottom: 40px;
+}
+
+.how {
+  margin-top: 120px;
+}
+
+.how h2 {
+  font-size: clamp(36px, 4.4vw, 56px);
+}
+
+.how-steps {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 20px;
+  margin: 32px 0 0;
+  padding: 0;
+  list-style: none;
+  counter-reset: step;
+}
+
+.how-step {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+  padding: 26px;
+  border: 2.5px solid var(--ink);
+  border-radius: 30px;
+  background: var(--card);
+}
+
+.how-step::after {
+  content: '';
+  position: absolute;
+  top: 50%;
+  right: -22px;
+  width: 22px;
+  height: 3px;
+  background: repeating-linear-gradient(90deg, var(--pink) 0 5px, transparent 5px 9px);
+}
+
+.how-step:last-child::after {
+  display: none;
+}
+
+.how-num {
+  display: grid;
+  place-items: center;
+  width: 56px;
+  height: 56px;
+  border-radius: 50%;
+  font-family: var(--font-display);
+  font-weight: 800;
+  font-size: 28px;
+}
+
+.how-donor .how-num {
+  background: var(--pink-soft);
+  color: var(--pink-deep);
+}
+
+.how-partner .how-num {
+  background: var(--mint-soft);
+  color: var(--green-deep);
+}
+
+.how-runner .how-num {
+  background: var(--ink);
+  color: var(--on-ink);
+}
+
+.how-step p {
+  font-size: 18px;
+  line-height: 1.5;
+  color: var(--ink-soft);
+}
+
+.how-step p b {
+  color: var(--ink);
+}
+
+.how-cta {
+  margin-top: auto;
+  align-self: flex-start;
