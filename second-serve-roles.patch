+}
+
+.needs-empty {
+  margin-top: 16px;
+  padding: 28px 20px;
+  border: 2.5px dashed var(--line);
+  border-radius: 22px;
+  text-align: center;
+  color: var(--ink-soft);
+}
+
+.needs-empty-title {
+  font-family: var(--font-display);
+  font-weight: 800;
+  font-size: 24px;
+  color: var(--ink);
+}
+
+.feed ol {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.feed li {
+  display: flex;
+  gap: 10px;
+  padding: 8px 0;
+  border-bottom: 1.5px dashed var(--line);
+  font-size: 14px;
+  line-height: 1.4;
+}
+
+.feed-time {
+  flex: none;
+  min-width: 62px;
+  font-weight: 700;
+  color: var(--ink-faint);
+}
+
+.feed-good {
+  color: var(--green-deep);
+}
+
+.feed-warn {
+  color: var(--pink-deep);
+}
+
+.coord-page .feed {
+  margin-top: 40px;
+}
+
+.food-thanks {
+  font-size: 14.5px;
+  font-style: italic;
+  color: var(--pink-deep);
+}
+
+@media (max-width: 1000px) {
